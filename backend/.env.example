# Copia este archivo a .env y completa tus valores. NO subas .env a GitHub.
# Spring no lee .env por sí solo: carga las variables en tu terminal (ver README.md).

# Cadena de conexión de MongoDB Atlas (base de datos tutofast)
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/tutofast?retryWrites=true&w=majority

# Secreto para firmar los JWT (mínimo 32 caracteres; usa uno aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-caracteres-minimo

# Administrador inicial (opcional): se crea al arrancar si no existe ningún ADMINISTRADOR
ADMIN_CORREO=admin@tutofast.local
ADMIN_CLAVE=Cambiame#2026

# Origen permitido por CORS (frontend)
FRONTEND_URL=http://localhost:5500

# Puerto HTTP (Render lo inyecta solo)
PORT=8080

# true en Atlas/Render (replica set); false con Mongo local sin replica set
MONGO_TRANSACCIONES=false
